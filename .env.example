# Переменные сборки мобильного приложения. Читаются в app.config.js через dotenv.
# Скопировать в .env (он под .gitignore) и заполнить.
#
# Бэкенд настраивается отдельно — см. backend/.env.example

# Ключ Google Maps для отрисовки карты на устройстве.
# Ограничить по имени пакета kz.saferoute.app в Google Cloud Console.
# Ключ для Directions живёт только на сервере — здесь его быть не должно.
GOOGLE_MAPS_API_KEY=

# DSN Sentry. Пусто — крашрепортинг выключен.
SENTRY_DSN=

# EAS project ID для OTA-обновлений, выдаётся командой `eas init`.
# Пусто — обновления выключены, приложение работает на встроенном бандле.
# Подробнее: docs/releases.md
EAS_PROJECT_ID=

# versionCode для локальных сборок. На EAS проставляется автоматически
# (eas.json: appVersionSource=remote, autoIncrement).
VERSION_CODE=1
