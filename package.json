    "@supabase/supabase-js": "^2.118.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
