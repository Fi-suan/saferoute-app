{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "preview": {
            "android": {
                "buildType": "apk",
                "autoIncrement": true
            },
            "channel": "preview"
        },
        "production": {
            "android": {
                "buildType": "app-bundle",
                "autoIncrement": true
            },
            "channel": "production"
        }
    },
    "submit": {
        "production": {
            "android": {
                "serviceAccountKeyPath": "./google-service-account.json",
                "track": "internal"
            }
        }
    }
}
