# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saferoute

# JWT Auth — generate a strong secret for production
JWT_SECRET=your-secret-key-here

# Google Maps API key (for Directions proxy — keep server-side only)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://saferoute.kz,https://admin.saferoute.kz

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_REPORT=10/minute

# Optional: OpenAI for AI incident verification
OPENAI_API_KEY=

# Optional: Firebase for push notifications
FIREBASE_CREDENTIALS_PATH=

# ── Хранилище фотографий (S3-совместимое) ────────────────────────────────────
# Пока не заданы — фото проверяется моделью и не сохраняется, photo_url пустой.
# Подробнее и почему выбран Cloudflare R2: docs/photo-storage.md
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес бакета: домен r2.dev или свой CNAME
S3_PUBLIC_BASE_URL=
# Для R2/MinIO — адрес хранилища. Для обычного AWS S3 оставить пустым.
S3_ENDPOINT_URL=
# У R2 всегда auto; для AWS — регион бакета
S3_REGION=auto
